<aside class="w-64 bg-white border-r border-gray-200 flex flex-col h-full">
  <!-- Logo -->
  <div class="p-4 border-b border-gray-200">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center">
        <span class="text-white font-bold text-sm">P</span>
      </div>
      <span class="text-lg font-semibold text-gray-900">Pingly</span>
    <% end %>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
    <p class="px-3 pt-3 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Inbox</p>

    <%= link_to root_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium #{current_page?(root_path) ? 'bg-indigo-50 text-indigo-700' : 'text-gray-700 hover:bg-gray-100'}" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z" />
      </svg>
      <span>All Messages</span>
      <% unread = Message.unread.count %>
      <% if unread > 0 %>
        <span class="ml-auto bg-indigo-600 text-white text-xs font-medium rounded-full px-2 py-0.5"><%= unread %></span>
      <% end %>
    <% end %>

    <%= link_to messages_path(status: "snoozed"), class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <span>Snoozed</span>
      <% snoozed = Message.snoozed.count %>
      <% if snoozed > 0 %>
        <span class="ml-auto text-gray-500 text-xs"><%= snoozed %></span>
      <% end %>
    <% end %>

    <%= link_to messages_path(status: "done"), class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <span>Done</span>
    <% end %>

    <p class="px-3 pt-5 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Categories</p>

    <% Category.all.each do |category| %>
      <%= link_to category_path(category), class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100" do %>
        <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: <%= category.color %>"></span>
        <span class="truncate"><%= category.name %></span>
        <% count = category.messages.active.count %>
        <% if count > 0 %>
          <span class="ml-auto text-gray-500 text-xs"><%= count %></span>
        <% end %>
      <% end %>
    <% end %>

    <p class="px-3 pt-5 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Settings</p>

    <%= link_to categories_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" />
      </svg>
      <span>Manage Categories</span>
    <% end %>

    <%= link_to platform_connections_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-100" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
      </svg>
      <span>Connections</span>
    <% end %>
  </nav>
</aside>
