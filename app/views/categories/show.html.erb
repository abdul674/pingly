<div class="max-w-6xl">
  <div class="flex items-center gap-3 mb-6">
    <span class="w-4 h-4 rounded-full" style="background-color: <%= @category.color %>"></span>
    <h1 class="text-2xl font-bold text-gray-900"><%= @category.name %></h1>
  </div>

  <div id="category_<%= @category.id %>" class="space-y-2">
    <%= turbo_stream_from "category_#{@category.id}" %>
    <% @messages.each do |message| %>
      <%= render "messages/message_card", message: message %>
    <% end %>

    <% if @messages.empty? %>
      <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <p class="text-gray-500">No messages in this category.</p>
      </div>
    <% end %>
  </div>
</div>
