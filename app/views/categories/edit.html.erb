<div class="max-w-2xl">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Category</h1>
  <%= render "categories/form", category: @category %>

  <!-- Rules -->
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">Rules</h2>

    <div class="bg-white rounded-xl border border-gray-200 divide-y divide-gray-200 mb-4">
      <% @category.category_rules.each do |rule| %>
        <div class="flex items-center justify-between p-3">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600"><%= rule.match_type %></span>
            <code class="text-sm text-gray-800"><%= rule.pattern %></code>
          </div>
          <%= button_to "Remove", category_rule_path(rule), method: :delete, class: "text-sm text-red-600 hover:text-red-800", data: { turbo_confirm: "Remove this rule?" } %>
        </div>
      <% end %>

      <% if @category.category_rules.empty? %>
        <div class="p-4 text-sm text-gray-500 text-center">No rules yet. Add one below.</div>
      <% end %>
    </div>

    <!-- Add Rule -->
    <%= form_with model: CategoryRule.new, url: category_category_rules_path(@category), class: "flex items-end gap-3" do |f| %>
      <div class="flex-1">
        <%= f.label :pattern, "Pattern", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :pattern, class: "w-full rounded-lg border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm", placeholder: "e.g. urgent" %>
      </div>
      <div>
        <%= f.label :match_type, "Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :match_type, [["Keyword", "keyword"], ["Regex", "regex"]], {}, class: "rounded-lg border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-sm" %>
      </div>
      <%= f.submit "Add Rule", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
    <% end %>
  </div>

  <% if @category.name != "Uncategorized" %>
    <div class="mt-8 pt-6 border-t border-gray-200">
      <%= button_to "Delete Category", category_path(@category), method: :delete,
        class: "px-4 py-2 bg-red-50 text-red-700 text-sm font-medium rounded-lg hover:bg-red-100 transition",
        data: { turbo_confirm: "Delete this category and all its rules?" } %>
    </div>
  <% end %>
</div>
