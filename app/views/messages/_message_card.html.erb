<%= tag.div id: dom_id(message), class: "bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition #{message.status == 'unread' ? 'border-l-4 border-l-indigo-500' : ''}", data: { controller: "message-actions" } do %>
  <div class="flex items-start gap-3">
    <!-- Avatar -->
    <div class="flex-shrink-0">
      <% if message.sender_avatar.present? %>
        <img src="<%= message.sender_avatar %>" class="w-9 h-9 rounded-full" alt="<%= message.sender_name %>">
      <% else %>
        <div class="w-9 h-9 rounded-full bg-gray-200 flex items-center justify-center">
          <span class="text-sm font-medium text-gray-600"><%= message.sender_name&.first&.upcase || "?" %></span>
        </div>
      <% end %>
    </div>

    <!-- Content -->
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="font-medium text-sm text-gray-900"><%= message.sender_name || "Unknown" %></span>
        <span class="text-xs text-gray-400">#<%= message.source&.name || "unknown" %></span>
        <span class="text-xs text-gray-400"><%= time_ago_short(message.received_at) %></span>
        <% if message.mentioned? %>
          <span class="inline-flex items-center rounded-full bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700">@you</span>
        <% end %>
      </div>

      <p class="text-sm text-gray-700 line-clamp-2"><%= message.content %></p>

      <% if message.categories.any? %>
        <div class="flex items-center gap-1.5 mt-2">
          <% message.categories.each do |cat| %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium text-white" style="background-color: <%= cat.color %>">
              <%= cat.name %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-1 flex-shrink-0">
      <% if message.status == "unread" %>
        <%= button_to mark_read_message_path(message), method: :patch, class: "p-1.5 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition", title: "Mark as read" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 9v.906a2.25 2.25 0 0 1-1.183 1.981l-6.478 3.488M2.25 9v.906a2.25 2.25 0 0 0 1.183 1.981l6.478 3.488m8.839 2.51-4.66-2.51m0 0-1.023-.55a2.25 2.25 0 0 0-2.134 0l-1.022.55m0 0-4.661 2.51m16.5 1.615a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V8.844a2.25 2.25 0 0 1 1.183-1.981l7.5-4.039a2.25 2.25 0 0 1 2.134 0l7.5 4.039a2.25 2.25 0 0 1 1.183 1.98V19.5Z" />
          </svg>
        <% end %>
      <% end %>

      <%= button_to mark_done_message_path(message), method: :patch, class: "p-1.5 rounded-lg text-gray-400 hover:text-green-600 hover:bg-green-50 transition", title: "Mark as done" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
      <% end %>

      <div class="relative" data-message-actions-target="snoozeMenu">
        <button data-action="click->message-actions#toggleSnooze" class="p-1.5 rounded-lg text-gray-400 hover:text-amber-600 hover:bg-amber-50 transition" title="Snooze">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </button>
        <div class="hidden absolute right-0 top-full mt-1 w-40 bg-white rounded-lg shadow-lg border border-gray-200 py-1 z-10" data-message-actions-target="snoozeDropdown">
          <%= button_to snooze_message_path(message, duration: "30_min"), method: :patch, class: "w-full text-left px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-100" do %>30 minutes<% end %>
          <%= button_to snooze_message_path(message, duration: "1_hour"), method: :patch, class: "w-full text-left px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-100" do %>1 hour<% end %>
          <%= button_to snooze_message_path(message, duration: "3_hours"), method: :patch, class: "w-full text-left px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-100" do %>3 hours<% end %>
          <%= button_to snooze_message_path(message, duration: "tomorrow"), method: :patch, class: "w-full text-left px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-100" do %>Tomorrow 9am<% end %>
          <%= button_to snooze_message_path(message, duration: "next_week"), method: :patch, class: "w-full text-left px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-100" do %>Next week<% end %>
        </div>
      </div>

      <% if message.deep_link.present? %>
        <%= link_to message.deep_link, target: "_blank", rel: "noopener", class: "p-1.5 rounded-lg text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition", title: "Open in Slack" do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
