<div class="max-w-6xl">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Inbox</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @unread_count %> unread message<%= @unread_count == 1 ? '' : 's' %></p>
    </div>
    <div class="flex items-center gap-2" data-controller="filters">
      <select data-action="change->filters#filter" data-filters-target="status"
              class="text-sm border border-gray-300 rounded-lg px-3 py-1.5 bg-white text-gray-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
        <option value="">All statuses</option>
        <option value="unread">Unread</option>
        <option value="read">Read</option>
      </select>
    </div>
  </div>

  <% if @connections.empty? %>
    <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 mx-auto text-gray-400 mb-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
      </svg>
      <h2 class="text-lg font-semibold text-gray-900 mb-2">No connections yet</h2>
      <p class="text-gray-500 mb-6">Connect your Slack workspace to start receiving messages.</p>
      <%= link_to "Add Connection", new_platform_connection_path, class: "inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition" %>
    </div>
  <% else %>
    <div id="messages" class="space-y-2">
      <%= turbo_stream_from "messages" %>
      <% @messages.each do |message| %>
        <%= render "messages/message_card", message: message %>
      <% end %>

      <% if @messages.empty? %>
        <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 mx-auto text-gray-400 mb-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <h2 class="text-lg font-semibold text-gray-900 mb-2">All caught up!</h2>
          <p class="text-gray-500">No active messages in your inbox.</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
