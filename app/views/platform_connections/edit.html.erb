<div class="max-w-2xl">
  <div class="mb-4">
    <%= link_to "Back to Connections", platform_connections_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Connection</h1>
  <%= render "platform_connections/form", connection: @connection %>

  <div class="mt-8 pt-6 border-t border-gray-200">
    <%= button_to "Delete Connection", platform_connection_path(@connection), method: :delete,
      class: "px-4 py-2 bg-red-50 text-red-700 text-sm font-medium rounded-lg hover:bg-red-100 transition",
      data: { turbo_confirm: "Delete this connection and all its sources?" } %>
  </div>
</div>
